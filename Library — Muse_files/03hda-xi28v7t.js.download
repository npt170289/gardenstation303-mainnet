a": {"message": "Device unregistered. All local data has been wiped."}}'}},{id:"default_unknown",label:"Default — unknown command",rule:{default:!0,stdout:'{"success": false, "data": null, "error": "unknown command"}',exit_code:1}}]},{id:"gmail",binaryName:"gmail",displayName:"Gmail",description:"Mock the Gmail CLI (--status auth, gmail-query search, trash/draft).",category:"email",templates:[{id:"status_linked",label:"Status — linked",rule:{match_args:"--status",stdout:'{"ok": true, "action": "status", "is_linked": true, "disconnect_url": "https://agent.meta.ai/connectors/gmail/disconnect?token=..."}'}},{id:"search_unread",label:"Search — 1 unread message",rule:{match_args:"is:unread|from:|to:|subject:",stdout:'{"ok": true, "action": "search", "count": 1, "messages": [{"id": "18a7c2f9d4e1b3a0", "subject": "Re: planning", "from": "Alice <alice@example.com>", "date": "2026-06-09T14:22:00Z", "snippet": "Quick update on the roadmap...", "body": "Quick update on the roadmap...\\n\\nAlice", "attachments": []}]}'}},{id:"send",label:"Send — success",rule:{match_args:"--to\\b.*--subject\\b(?!.*--draft)",stdout:'{"ok": true, "action": "send", "message_id": "18a7c302aabbccdd"}'}},{id:"draft",label:"Draft — success",rule:{match_args:"--draft",stdout:'{"ok": true, "action": "draft", "message_id": "18a7c302aabbccdd", "draft_id": "r-7723451"}'}},{id:"trash",label:"Trash — success",rule:{match_args:"--trash-id",stdout:'{"ok": true, "action": "trash", "message_id": "18a7c2f9d4e1b3a0"}'}}]},{id:"google_drive",binaryName:"google-drive",displayName:"Google Drive",description:"Mock the Google Drive CLI (--status auth, list/search/get/create-folder/upload/move/delete).",category:"files",templates:[{id:"list_root",label:"List root — 1 file",rule:{match_args:"^list\\b",stdout:'{"ok": true, "count": 1, "files": [{"id": "1A2B3C", "name": "Q2 plan.gdoc", "mime_type": "application/vnd.google-apps.document", "web_view_link": "https://docs.google.com/document/d/1A2B3C/edit", "parents": ["root"]