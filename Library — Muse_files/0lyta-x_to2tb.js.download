class HatchVoiceSpeechBufferProcessor extends AudioWorkletProcessor {
  constructor(options) {
    super();
    const config = options.processorOptions;
    this.capacity = Math.max(1, Math.round(config.bufferSeconds * sampleRate));
    this.ring = new Float32Array(this.capacity);
    this.start = 0;
    this.size = 0;
    this.silenceLevel = config.silenceLevel;
    this.speechLevel = config.speechLevel;
    this.keepSilence = Math.round(config.keepSilenceSeconds * sampleRate);
    this.speechThreshold = Math.round(config.speechSeconds * sampleRate);
    this.catchUpCap = Math.round(config.catchUpCapSeconds * sampleRate);
    this.endSilence = Math.round(config.endSilenceSeconds * sampleRate);
    this.mode = "buffer";
    this.held = false;
    this.started = false;
    this.silentRun = 0;
    this.heard = 0;
    this.quietRun = 0;
    this.reportedSpeech = false;
    this.speaking = false;
    this.discarding = 0;
    this.replayed = 0;
    this.skipped = 0;
    this.port.onmessage = (event) => this.receive(event.data);
  }

  receive(command) {
    if (command.type === "discard") {
      this.discarding = Math.max(this.discarding, Math.round(command.seconds * sampleRate));
    } else if (command.type === "drain" && this.mode === "buffer") {
      this.mode = "drain";
    } else if (command.type === "hold") {
      this.held = command.held;
    }
  }

  process(inputs, outputs) {
    if (!this.started) {
      this.started = true;
      this.port.postMessage({ type: "alive" });
    }
    const input = inputs[0] && inputs[0][0];
    const output = outputs[0][0];
    if (this.mode === "live") {
      if (input) output.set(input);
      else output.fill(0);
      return true;
    }
    if (this.held) {
      // An earcon drop counts microphone time, which passes while held too.
      if (input) this.discarding = Math.max(0, this.discarding - input.length);
    } else if (input) {
      this.record(input);
    }
    if (this.mode === "drain" && !this.held) this.replay(output);
    else output.fill(0);
    return true;
  }

  record(samples) {
    let begin = 0;
    if (this.discarding > 0) {
      begin = Math.min(this.discarding, samples.length);
      this.discarding -= begin;
      if (begin === samples.length) return;
    }
    const frames = samples.length - begin;
    let energy = 0;
    for (let i = begin; i < samples.length; i++) energy += samples[i] * samples[i];
    const level = Math.sqrt(energy / frames);
    this.detectSpeech(level, frames);
    if (level < this.silenceLevel) {
      this.silentRun += frames;
      if (this.silentRun > this.keepSilence) {
        this.skipped += frames;
        return;
      }
    } else {
      this.silentRun = 0;
    }
    for (let i = begin; i < samples.length; i++) {
      this.ring[(this.start + this.size) % this.capacity] = samples[i];
      if (this.size < this.capacity) {
        this.size++;
      } else {
        this.start = (this.start + 1) % this.capacity;
        this.skipped++;
      }
    }
  }

  detectSpeech(level, frames) {
    if (level >= this.speechLevel) {
      this.quietRun = 0;
      if (this.heard >= this.speechThreshold) return;
      this.heard += frames;
      if (this.heard < this.speechThreshold) return;
      if (!this.reportedSpeech) this.port.postMessage({ type: "speech" });
      else if (!this.speaking) this.port.postMessage({ type: "speech_resumed" });
      this.reportedSpeech = true;
      this.speaking = true;
    } else {
      this.quietRun += frames;
      if (this.quietRun > this.keepSilence) this.heard = 0;
      if (this.speaking && this.quietRun >= this.endSilence) {
        this.speaking = false;
        this.port.postMessage({ type: "speech_ended" });
      }
    }
  }

  replay(output) {
    const frames = Math.min(this.size, output.length);
    for (let i = 0; i < frames; i++) output[i] = this.ring[(this.start + i) % this.capacity];
    output.fill(0, frames);
    this.start = (this.start + frames) % this.capacity;
    this.size -= frames;
    this.replayed += frames;
    if (this.size > 0 && this.replayed >= this.catchUpCap) {
      this.skipped += this.size;
      this.size = 0;
    }
    if (this.size === 0) {
      this.mode = "live";
      this.ring = new Float32Array(0);
      this.port.postMessage({
        type: "live",
        replayedSeconds: this.replayed / sampleRate,
        skippedSeconds: this.skipped / sampleRate,
      });
    }
  }
}

registerProcessor(${JSON.stringify(n6)}, HatchVoiceSpeechBufferProcessor);
